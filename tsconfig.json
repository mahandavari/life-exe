{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ]
  },
  "include": [
    "static-app/**/*.tsx",
    "components/life/**/*.ts",
    "components/life/**/*.tsx",
    "vite.pages.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist-pages"
  ]
}
